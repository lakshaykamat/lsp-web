# Base URL of the LSP backend (see docs/api.md §2).
# Required. The Next.js /api/* routes proxy to this origin.
LSP_API_BASE_URL=https://api.lsp.example.com

# When "true", every page and API route is disabled and visitors are
# shown the /contact-admin page. Leave unset or "false" to run normally.
IS_DISABLED=false
